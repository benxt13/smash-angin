rules_version = '2';

// Aturan Firestore untuk proyek smash-angin (jalur data: artifacts/smash-angin-prod/public/data/**)
// Cara pasang: Firebase Console -> Firestore Database -> Rules -> tempel isi berkas ini -> Publish.
// SARAN: uji dulu di project dev sebelum dipasang di produksi (lihat FIREBASE-SETUP.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // Harus sama dengan ADMIN_EMAIL di index.html
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@smashangin.cloud';
    }

    // Login (bukan anonim) - pakai ini kalau anggota juga perlu menulis skor
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /artifacts/smash-angin-prod/public/data/{document=**} {
      // Papan skor memang publik: siapa pun boleh membaca
      allow read: if true;

      // Pilih SATU baris di bawah ini:
      allow write: if isAdmin();      // paling ketat: hanya admin
      // allow write: if isSignedIn();   // anggota yang login boleh menulis
      // allow write: if request.auth != null; // blokir tamu, tapi akun anonim masih bisa
    }

    // Sisanya ditolak
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
